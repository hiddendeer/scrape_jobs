from DrissionPage import ChromiumPage, ChromiumOptions
import time
import logging
import socket
import os
from cleaner import standardize_job
from config import Config

logger = logging.getLogger(__name__)


class BrowserInitializationError(Exception):
    """浏览器初始化失败时抛出的异常"""
    pass


def is_browser_available(port: int) -> bool:
    """
    检测指定端口是否有浏览器在监听

    Args:
        port: 要检测的端口号

    Returns:
        bool: 如果端口有浏览器监听返回 True，否则返回 False
    """
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(1)
            result = s.connect_ex(('127.0.0.1', port))
            return result == 0
    except Exception as e:
        logger.warning(f"Error checking browser availability on port {port}: {e}")
        return False

class BossScraper:
    def __init__(self):
        """
        初始化 BossScraper，自动管理浏览器连接和启动

        支持两种模式：
        1. 连接模式：连接到已存在的浏览器实例
        2. 启动模式：自动启动新的浏览器实例

        通过 Config.BROWSER_AUTO_LAUNCH 控制行为
        """
        self._auto_launched = False
        self.page = None

        # 检查浏览器是否可用
        browser_available = is_browser_available(Config.CHROME_PORT)

        try:
            if browser_available:
                # 尝试连接到现有浏览器
                logger.info(f"Browser detected on port {Config.CHROME_PORT}, attempting to connect...")
                self._connect_to_browser()
            else:
                # 浏览器不可用，根据配置决定是否启动
                if Config.BROWSER_AUTO_LAUNCH:
                    logger.warning(f"No browser detected on port {Config.CHROME_PORT}, launching new browser...")
                    self._launch_browser()
                else:
                    # 不自动启动，抛出异常
                    raise BrowserInitializationError(
                        f"No browser detected on port {Config.CHROME_PORT}. "
                        f"Please start Chrome manually with --remote-debugging-port={Config.CHROME_PORT} "
                        f"or set BROWSER_AUTO_LAUNCH=true in your configuration."
                    )
        except Exception as e:
            logger.error(f"Failed to initialize browser: {e}")
            # 清理可能已创建的资源
            if self._auto_launched and self.page:
                try:
                    self.page.quit()
                except Exception:
                    pass
            raise BrowserInitializationError(
                f"Failed to initialize browser. "
                f"Port: {Config.CHROME_PORT}, "
                f"Auto-launch: {Config.BROWSER_AUTO_LAUNCH}, "
                f"Headless: {Config.BROWSER_HEADLESS}. "
                f"Reason: {str(e)}. "
                f"Solution: {'Check if Chrome is installed or verify BROWSER_EXECUTABLE_PATH' if Config.BROWSER_AUTO_LAUNCH else 'Start Chrome with --remote-debugging-port=' + str(Config.CHROME_PORT)}"
            ) from e

        logger.info(f"Browser initialized successfully (mode: {'auto-launched' if self._auto_launched else 'connected'})")

    def _connect_to_browser(self):
        """连接到已存在的浏览器实例"""
        co = ChromiumOptions()
        co.set_argument(f'--remote-debugging-port={Config.CHROME_PORT}')
        try:
            self.page = ChromiumPage(co)
            logger.info(f"Successfully connected to existing browser on port {Config.CHROME_PORT}")
        except Exception as e:
            logger.warning(f"Failed to connect to browser on port {Config.CHROME_PORT}: {e}")
            raise

    def _launch_browser(self):
        """启动新的浏览器实例"""
        co = ChromiumOptions()

        # 保留现有的远程调试端口配置
        co.set_argument(f'--remote-debugging-port={Config.CHROME_PORT}')

        # 配置无头模式
        if Config.BROWSER_HEADLESS:
            co.set_argument('--headless')
            co.set_argument('--disable-gpu')
            co.set_argument('--no-sandbox')
            logger.info("Launching browser in headless mode")

        # 配置自定义可执行路径
        if Config.BROWSER_EXECUTABLE_PATH:
            if os.path.exists(Config.BROWSER_EXECUTABLE_PATH):
                co.set_browser_path(Config.BROWSER_EXECUTABLE_PATH)
                logger.info(f"Using custom browser path: {Config.BROWSER_EXECUTABLE_PATH}")
            else:
                raise BrowserInitializationError(
                    f"Browser executable not found at: {Config.BROWSER_EXECUTABLE_PATH}. "
                    f"Please verify BROWSER_EXECUTABLE_PATH or remove it to use system default."
                )

        try:
            self.page = ChromiumPage(co)
            self._auto_launched = True
            logger.info(f"Successfully launched new browser (headless: {Config.BROWSER_HEADLESS})")
        except Exception as e:
            logger.error(f"Failed to launch browser: {e}")
            raise

    def __del__(self):
        """
        清理浏览器资源

        仅关闭自动启动的浏览器实例，保留用户手动启动的浏览器
        """
        if self._auto_launched and hasattr(self, 'page') and self.page:
            try:
                logger.info("Closing auto-launched browser...")
                self.page.quit()
                logger.info("Auto-launched browser closed successfully")
            except Exception as e:
                logger.warning(f"Error while closing browser: {e}")

    def close(self):
        """
        显式关闭浏览器并释放资源

        可供用户主动调用的清理方法
        """
        if hasattr(self, 'page') and self.page:
            try:
                if self._auto_launched:
                    logger.info("Closing browser via explicit close() call...")
                    self.page.quit()
                    self.page = None
                else:
                    logger.info("Browser was externally managed, not closing")
            except Exception as e:
                logger.warning(f"Error while closing browser: {e}")
                raise

    def scrape_keyword(self, keyword, pages=3, city_code="100010000"):
        """
        Scrapes job data using infinite scroll.
        'pages' here essentially means how many times to scroll/load more.
        """
        results = []
        target_url_substring = 'wapi/zpgeek/search/joblist.json'
        
        try:
            # Start listening for network packets
            self.page.listen.start(target_url_substring)
            logger.info(f"Started listening for {target_url_substring}")
            
            # Navigate to initial Page
            # We assume the first page loads automatically upon visit
            search_url = f'https://www.zhipin.com/web/geek/job?query={keyword}&city={city_code}'
            logger.info(f"Navigating to {search_url}")
            self.page.get(search_url)
            
            # Loop for the number of "pages" requested
            for i in range(1, pages + 1):
                logger.info(f"Processing batch {i}...")

                # For the first page, we might just wait.
                # For subsequent pages, we need to scroll.
                if i > 1:
                    logger.info("Scrolling to bottom to trigger load...")
                    self.page.scroll.to_bottom()
                
                # Wait for the data packet
                res = self.page.listen.wait(timeout=15)
                
                if not res:
                    logger.warning(f"Timeout waiting for response packet on batch {i}.")
                    # Attempt to scroll again if it failed? Or just break?
                    # Let's break to avoid infinite loops of nothingness.
                    break
                
                # Check response
                if res.response.status != 200:
                    logger.warning(f"Response status {res.response.status} on batch {i}")
                    continue

                json_data = res.response.body
                
                if json_data and isinstance(json_data, dict):
                    zp_data = json_data.get('zpData')
                    if zp_data and isinstance(zp_data, dict):
                        job_list = zp_data.get('jobList', [])
                        logger.info(f"Found {len(job_list)} jobs in batch {i}")
                        
                        if not job_list:
                            has_more = zp_data.get('hasMore')
                            if has_more is False:
                                logger.info("Server indicates no more jobs (hasMore=False). Ending scrape.")
                                break
                        
                        page_jobs = []
                        for job in job_list:
                            encrypt_id = job.get('encryptJobId')
                            # Find the job card in the list panel
                            # The job card usually has a unique identifier or we can match via encrypt_id if present in DOM
                            # Based on typical Boss Zhipin structure, we can try finding by text or index
                            # Let's try to click the card to reveal description
                            logger.info(f"Extracting description for job: {job.get('jobName')}...")
                            
                            job_desc = ""
                            try:
                                # Optimized selector: targeting the job card's main clickable area
                                # We use a more stable XPath combined with encryption ID
                                card_selector = f'xpath://li[.//a[contains(@href, "{encrypt_id}")]]//div[contains(@class, "job-card-left")]'
                                card = self.page.ele(card_selector, timeout=5)
                                if not card:
                                    # Fallback: try the link itself
                                    card = self.page.ele(f'xpath://a[contains(@href, "{encrypt_id}")]', timeout=2)
                                
                                if card:
                                    # Ensure card is in view and click
                                    card.scroll.to_see()
                                    card.click()
                                    
                                    # Wait a split second for the JS trigger to reflect in the DOM
                                    time.sleep(0.8)
                                    
                                    # Try multiple selectors for the description content
                                    # .job-detail-box .desc is primary (based on user image)
                                    # Others are fallbacks
                                    desc_selectors = [
                                        '.job-detail-box .desc',
                                        '.job-detail-box .job-sec-text',
                                        'xpath://p[contains(@class, "desc")]',
                                        '.job-detail-body .desc'
                                    ]
                                    
                                    found_desc = False
                                    for selector in desc_selectors:
                                        desc_ele = self.page.ele(selector, timeout=3)
                                        if desc_ele and desc_ele.text.strip():
                                            job_desc = desc_ele.text.strip()
                                            found_desc = True
                                            break
                                    
                                    if not found_desc:
                                        logger.warning(f"Description element not found for {encrypt_id} after trying multiple selectors.")
                                else:
                                    logger.warning(f"Card element not found for {encrypt_id}")
                            except Exception as e:
                                logger.error(f"Error clicking/extracting description: {e}")

                            raw_job = {
                                'encryptJobId': encrypt_id,
                                'jobName': job.get('jobName'),
                                'brandName': job.get('brandName'),
                                'cityName': job.get('cityName'),
                                'areaDistrict': job.get('areaDistrict'),
                                'salaryDesc': job.get('salaryDesc'),
                                'jobExperience': job.get('jobExperience'),
                                'jobDegree': job.get('jobDegree'),
                                'skills': job.get('skills', []),
                                'job_desc': job_desc,
                            }
                            
                            standardized_job = standardize_job(raw_job)
                            page_jobs.append(standardized_job)
                        
                        if page_jobs:
                            yield page_jobs
                            
                    else:
                        logger.warning(f"zpData not found or invalid format on batch {i}.")
                else:
                    logger.warning(f"Invalid JSON response on batch {i}.")
                
                # Small random delay to let the page settle
                time.sleep(2)
        
        except Exception as e:
            logger.error(f"Error during scraping: {e}")
        finally:
            self.page.listen.stop()
