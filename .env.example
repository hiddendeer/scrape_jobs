# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Table Configuration
INSERT_JOBS_TABLE=agent_jobs
QUERY_JOBS_TABLE=ems_jobs_new

# Browser Configuration
# Chrome remote debugging port (default: 9222)
# CHROME_PORT=9222
# Auto-launch browser if not running (default: true)
# Set to false if you want to manually start Chrome with --remote-debugging-port=9222
BROWSER_AUTO_LAUNCH=true
# Run Chrome in headless mode (no GUI, useful for servers)
BROWSER_HEADLESS=false
# Custom path to Chrome executable (optional)
# Use this if Chrome is not in the standard installation location
# Example Windows: BROWSER_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# Example Linux: BROWSER_EXECUTABLE_PATH="/usr/bin/google-chrome"
# Example macOS: BROWSER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# BROWSER_EXECUTABLE_PATH=

# LLM Configuration for Career Analysis
# Get your API key from your LLM provider (OpenAI, Azure OpenAI, etc.)
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7

# Notes:
# - For OpenAI: Use https://api.openai.com/v1 as LLM_API_BASE
# - For Azure OpenAI: Use your Azure endpoint, e.g., https://your-resource.openai.azure.com/
# - For other compatible APIs: Use their respective base URLs
# - Common model names: gpt-4, gpt-4-turbo, gpt-3.5-turbo, gpt-4o-mini
# - Temperature controls creativity (0.0 = focused, 1.0 = creative)
